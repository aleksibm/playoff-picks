# Copy to /etc/playoff-picks.env and keep it root-owned (0600).
NODE_ENV=production
PLAYOFF_PICK_PUBLIC_ORIGIN=https://picks.aleksi.net
PLAYOFF_PICK_PROXY=cloudflare-tunnel
PLAYOFF_PICK_PORT=8765
PLAYOFF_PICK_ADMIN_PORT=8766
PLAYOFF_PICK_DATA_DIR=/var/lib/playoff-picks
PLAYOFF_PICK_FETCH_STANDINGS=1
